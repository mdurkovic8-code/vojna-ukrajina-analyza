{
  "name": "vojna-ukrajina-analyza",
  "version": "1.0.0",
  "private": true,
  "description": "Opakovateľná slovenská analytická správa s publikovaním cez GitHub Pages.",
  "scripts": {
    "build": "node scripts/build-report.cjs",
    "archive": "node scripts/archive-edition.cjs",
    "verify": "node scripts/verify-report.cjs",
    "verify:archive": "node scripts/verify-archive-immutability.cjs",
    "stage": "node scripts/stage-pages.cjs",
    "check": "npm run build && npm run verify && npm run stage",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0"
  },
  "engines": {
    "node": ">=20"
  }
}
